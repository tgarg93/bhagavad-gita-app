# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# API keys live in .env only — config files are tracked product assets
# (the old **/config/*Config.ts ignore predates keys moving to env vars;
# it silently kept the Krishna persona in geminiConfig.ts out of the repo)

# typescript
*.tsbuildinfo
app.json.backup

# Native build artifacts
build/

# Expert review packets — point-in-time artifacts, regenerate with scripts/export-review-packets.mjs
docs/review-packets/
